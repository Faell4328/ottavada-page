---
import Docs from "~/components/Docs.astro";
import Thanks from "~/components/Thanks.astro";
import { SUPPORTED_LOCALES, type Locale } from "~/i18n";

export function getStaticPaths() {
  const pages: Record<string, any> = {
    agradecimento: Thanks,
    docs: Docs,
  };
  const paths: Array<{
    params: { lang: string; page: string };
    props: { locale: Locale; component: any };
  }> = [];
  for (const lang of SUPPORTED_LOCALES) {
    for (const [slug, component] of Object.entries(pages)) {
      paths.push({ params: { lang, page: slug }, props: { locale: lang, component } });
    }
  }
  return paths;
}

const { locale, component: Component } = Astro.props as {
  locale: Locale;
  component: any;
};
---
<Component locale={locale} />
