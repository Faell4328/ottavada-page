---
import Docs from "~/components/Docs.astro";
import Thanks from "~/components/Thanks.astro";
import Download from "~/components/Download.astro";
import { PAGE_SLUGS, SUPPORTED_LOCALES, type Locale } from "~/i18n";

export function getStaticPaths() {
  const pages: Record<string, any> = {
    thanks: Thanks,
    docs: Docs,
    download: Download,
  };
  const paths: Array<{
    params: { lang: string; page: string };
    props: { locale: Locale; component: any };
  }> = [];
  for (const lang of SUPPORTED_LOCALES) {
    for (const [name, component] of Object.entries(pages)) {
      paths.push({
        params: { lang, page: PAGE_SLUGS[name as keyof typeof PAGE_SLUGS][lang] },
        props: { locale: lang, component },
      });
    }
  }
  return paths;
}

const { locale, component: Component } = Astro.props as {
  locale: Locale;
  component: any;
};
---
<Component locale={locale} />
