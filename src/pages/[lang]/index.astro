---
import Home from "~/components/Home.astro";
import { SUPPORTED_LOCALES, type Locale } from "~/i18n";

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: Locale };
---
<Home locale={locale} />
