---
import "~/styles/global.css";
import "~/styles/thanks.css";
import type { Locale } from "~/i18n";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/avif" href="/logo.avif" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      (function () {
        var STORAGE_KEY = "ottavada-lang";
        var SUPPORTED = ["en", "pt-BR", "es", "fr", "it", "de"];
        function isSupported(v) { return v && SUPPORTED.indexOf(v) !== -1; }
        function readStored() { try { return localStorage.getItem(STORAGE_KEY); } catch (e) { return null; } }
        function browserLocale() {
          var raw = (navigator.language || "").replace("_", "-");
          if (isSupported(raw)) return raw;
          var prefix = raw.split("-")[0];
          for (var i = 0; i < SUPPORTED.length; i++) {
            if (SUPPORTED[i].split("-")[0] === prefix) return SUPPORTED[i];
          }
          return null;
        }
        var segments = window.location.pathname.split("/").filter(Boolean);
        var currentLocale = segments[0] && isSupported(segments[0]) ? segments[0] : null;
        if (currentLocale) {
          try { localStorage.setItem(STORAGE_KEY, currentLocale); } catch (e) {}
          return;
        }
        var params = new URLSearchParams(window.location.search);
        if (params.has("lang")) return;
        var stored = readStored();
        var target = isSupported(stored) ? stored : browserLocale();
        if (!target) return;
        var rest = "/" + segments.join("/");
        var cleanRest = rest === "/" ? "" : rest;
        try { localStorage.setItem(STORAGE_KEY, target); } catch (e) {}
        window.location.replace("/" + target + cleanRest + window.location.search + window.location.hash);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
