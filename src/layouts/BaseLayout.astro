---
import "~/styles/global.css";
import "~/styles/chat.css";
import ChatWidget from "~/components/ChatWidget.astro";
import Header from "~/components/Header.astro";
import { type Locale, SUPPORTED_LOCALES, withLocale } from "~/i18n";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  ogImage?: string;
  preloadHeroImage?: boolean;
  pageType?: "website" | "article";
  bodyClass?: string;
  msValidate?: boolean;
  schemaJson?: string;
  showHeader?: boolean;
  showChat?: boolean;
}

const {
  locale,
  title,
  description,
  ogTitle,
  ogDescription,
  ogUrl = `https://ottavada.com/${locale}/`,
  ogImage = "https://ottavada.com/files/icon.avif",
  preloadHeroImage = false,
  pageType = "website",
  bodyClass,
  msValidate = false,
  schemaJson,
  showHeader = true,
  showChat = true,
} = Astro.props;

const siteOrigin = "https://ottavada.com";
const hreflangs = SUPPORTED_LOCALES.map((code) => ({
  code,
  href: `${siteOrigin}/${code}/`,
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    {msValidate && <meta name="msvalidate.01" content="468EBB3FEFF76E87B7F8FA13057D500A" />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:type" content={pageType} />
    <link rel="icon" type="image/avif" href="/files/icon.avif" />
    {preloadHeroImage && (
      <link rel="preload" as="image" href="/orquestra.avif" fetchpriority="high" />
    )}
    <link rel="preload" as="image" href="/files/icon.avif" fetchpriority="high" />
    {schemaJson && (
      <script type="application/ld+json" set:html={schemaJson} />
    )}
    {hreflangs.map(({ code, href }) => (
      <link rel="alternate" hreflang={code} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}/`} />
    <script is:inline>
      (function () {
        var STORAGE_KEY = "ottavada-lang";
        var SUPPORTED = ["en", "pt-BR", "es", "fr", "it", "de"];
        function isSupported(v) { return v && SUPPORTED.indexOf(v) !== -1; }
        function readStored() { try { return localStorage.getItem(STORAGE_KEY); } catch (e) { return null; } }
        function browserLocale() {
          var raw = (navigator.language || "").replace("_", "-");
          if (isSupported(raw)) return raw;
          var prefix = raw.split("-")[0];
          for (var i = 0; i < SUPPORTED.length; i++) {
            if (SUPPORTED[i].split("-")[0] === prefix) return SUPPORTED[i];
          }
          return null;
        }
        var segments = window.location.pathname.split("/").filter(Boolean);
        var currentLocale = segments[0] && isSupported(segments[0]) ? segments[0] : null;
        if (currentLocale) {
          try { localStorage.setItem(STORAGE_KEY, currentLocale); } catch (e) {}
          return;
        }
        var params = new URLSearchParams(window.location.search);
        if (params.has("lang")) return;
        var stored = readStored();
        var target = isSupported(stored) ? stored : browserLocale();
        if (!target) return;
        var rest = "/" + segments.join("/");
        var cleanRest = rest === "/" ? "" : rest;
        try { localStorage.setItem(STORAGE_KEY, target); } catch (e) {}
        window.location.replace("/" + target + cleanRest + window.location.search + window.location.hash);
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <div id="app">
      {showHeader && <Header locale={locale} pathname={Astro.url.pathname} />}
      <slot />
      {showChat && <ChatWidget locale={locale} />}
    </div>

    {showChat && <script>import "~/scripts/chat.ts";</script>}
    <script>import "~/scripts/lang-switcher.ts";</script>
  </body>
</html>
