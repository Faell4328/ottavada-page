---
import {
  LOCALE_FLAGS,
  LOCALE_LABELS,
  SUPPORTED_LOCALES,
  stripLocaleFromPath,
  withLocale,
  type Locale,
} from "~/i18n";

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props as Props;
const restPath = stripLocaleFromPath(pathname);
---

<div class="lang-flags">
  {
    SUPPORTED_LOCALES.map((code) => {
      const href = withLocale(restPath, code);
      return (
        <a
          class:list={["lang-btn", { active: code === locale }]}
          data-lang={code}
          title={LOCALE_LABELS[code]}
          aria-label={LOCALE_LABELS[code]}
          aria-current={code === locale ? "true" : undefined}
          href={href}
        >
          <img src={LOCALE_FLAGS[code]} alt="" />
        </a>
      );
    })
  }
</div>
