---
import {
  LOCALE_FLAGS,
  LOCALE_LABELS,
  PAGE_SLUGS,
  SUPPORTED_LOCALES,
  stripLocaleFromPath,
  withLocale,
  type Locale,
  type StaticPage,
} from "~/i18n";

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props as Props;
const restPath = stripLocaleFromPath(pathname);

let currentPage: StaticPage | null = null;
for (const [page, slugs] of Object.entries(PAGE_SLUGS)) {
  const slug = `/${slugs[locale]}/`;
  if (restPath === slug) {
    currentPage = page as StaticPage;
    break;
  }
}

function hrefFor(code: Locale): string {
  if (currentPage) {
    return withLocale(`/${PAGE_SLUGS[currentPage][code]}`, code);
  }
  return withLocale(restPath, code);
}
---

<div class="lang-flags">
  {
    SUPPORTED_LOCALES.map((code) => {
      const href = hrefFor(code);
      return (
        <a
          class:list={["lang-btn", { active: code === locale }]}
          data-lang={code}
          title={LOCALE_LABELS[code]}
          aria-label={LOCALE_LABELS[code]}
          aria-current={code === locale ? "true" : undefined}
          href={href}
        >
          <img src={LOCALE_FLAGS[code]} alt="" />
        </a>
      );
    })
  }
</div>
