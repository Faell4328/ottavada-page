---
import DocsLayout from "~/layouts/DocsLayout.astro";
import "~/styles/docs.css";
import { docs, type Locale, type DocsBlock } from "~/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = docs[locale];
const imageSuffix = locale === "pt-BR" ? "pt-BR" : "en";

function imageSrc(name: string): string {
  return `/docs/files/${name}-${imageSuffix}.avif`;
}

function renderInline(input: string): string {
  return input
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, "<b>$1</b>");
}
---

<DocsLayout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  ogTitle={t.meta.ogTitle}
  ogDescription={t.meta.ogDescription}
  bodyClass="docs-body"
>
  <aside class="docs-sidebar" id="docsSidebar" slot="sidebar" aria-label={t.nav.sidebarLabel}>
    <div class="docs-sidebar-inner">
      <div class="docs-sidebar-header">
        <span class="docs-sidebar-title">{t.nav.topics}</span>
        <button class="docs-sidebar-close" id="docsSidebarClose" aria-label={t.nav.close} type="button">
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg
          >
        </button>
      </div>
      <nav class="docs-sidebar-nav" aria-label={t.nav.topics}>
        <ul>
          <li>
            <a href="#mensagem-desenvolvedor" class="docs-nav-link" data-nav-target="mensagem-desenvolvedor"
              ><span class="docs-nav-text">{t.toc.mensagem}</span></a
            >
          </li>
          <li>
            <a href="#conceitos-essenciais" class="docs-nav-link" data-nav-target="conceitos-essenciais"
              ><span class="docs-nav-text">{t.toc.conceitos}</span></a
            >
          </li>
          <li>
            <a href="#instalacao" class="docs-nav-link" data-nav-target="instalacao"
              ><span class="docs-nav-text">{t.toc.instalacao}</span></a
            >
          </li>
          <li>
            <a href="#primeiros-passos" class="docs-nav-link" data-nav-target="primeiros-passos"
              ><span class="docs-nav-text">{t.toc.primeirosPassos}</span></a
            >
          </li>
          <li>
            <a href="#adicionando-musica" class="docs-nav-link" data-nav-target="adicionando-musica"
              ><span class="docs-nav-text">{t.toc.adicionandoMusica}</span></a
            >
          </li>
          <li>
            <a href="#enviando-nuvem" class="docs-nav-link" data-nav-target="enviando-nuvem"
              ><span class="docs-nav-text">{t.toc.enviandoNuvem}</span></a
            >
          </li>
          <li>
            <a href="#realizando-alteracoes" class="docs-nav-link" data-nav-target="realizando-alteracoes"
              ><span class="docs-nav-text">{t.toc.realizandoAlteracoes}</span></a
            >
          </li>
          <li>
            <a href="#backup" class="docs-nav-link" data-nav-target="backup"
              ><span class="docs-nav-text">{t.toc.backup}</span></a
            >
          </li>
          <li>
            <a href="#baixando" class="docs-nav-link" data-nav-target="baixando"
              ><span class="docs-nav-text">{t.toc.baixando}</span></a
            >
          </li>
          <li>
            <a href="#suporte" class="docs-nav-link" data-nav-target="suporte"
              ><span class="docs-nav-text">{t.toc.suporte}</span></a
            >
          </li>
        </ul>
      </nav>
    </div>
  </aside>

  <main class="container docs-main">
    <article class="docs-content">
      <section class="docs-section" id="mensagem-desenvolvedor">
        <h2>{t.toc.mensagem}</h2>
        {locale !== "pt-BR" && locale !== "en" && <p class="docs-images-note">{t.imagesNote}</p>}
        {
          t.sections.mensagem.blocks.map((block: DocsBlock) => {
            if (block.kind === "p") return <p set:html={renderInline(block.text)} />;
            return null;
          })
        }
      </section>

      <section class="docs-section" id="conceitos-essenciais">
        <h2>{t.toc.conceitos}</h2>
        {
          t.sections.conceitos.blocks.map((block: DocsBlock) => {
            if (block.kind === "h3") return <h3>{block.text}</h3>;
            if (block.kind === "h4") return <h4>{block.text}</h4>;
            if (block.kind === "p") return <p set:html={renderInline(block.text)} />;
            if (block.kind === "ul")
              return (
                <ul>
                  {block.items.map((it) => (
                    <li set:html={renderInline(it)} />
                  ))}
                </ul>
              );
            if (block.kind === "ol")
              return (
                <ol>
                  {block.items.map((it) => (
                    <li set:html={renderInline(it)} />
                  ))}
                </ol>
              );
            if (block.kind === "callout") {
              return (
                <div class="docs-callout">
                  <strong>{t.callouts[block.tone]}</strong>
                  <p set:html={renderInline(block.text)} />
                </div>
              );
            }
            if (block.kind === "image") return <img alt={block.alt} src={imageSrc(block.name)} />;
            return null;
          })
        }
      </section>

