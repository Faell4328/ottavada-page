---
import ThanksLayout from "~/layouts/ThanksLayout.astro";
import { thanks, withLocale, pagePath, type Locale } from "~/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = thanks[locale];
const docsHref = withLocale(pagePath("docs", locale), locale);
const RELEASE_BASE = import.meta.env.PUBLIC_RELEASE_BASE;
const LINUX_URL = "/ottavada.sh";
const MAC_URL = `${RELEASE_BASE}/${import.meta.env.PUBLIC_MAC_DMG}`;
---

<ThanksLayout locale={locale} title={t.meta.title} description={t.meta.description}>
  <main class="thanks-layout">
    <div class="container" style="max-width: 56rem">
      <div class="thanks-card">
        <div>
          <h1>{t.heading}</h1>
          <p class="countdown-text" id="thanks-countdown">
            {t.countdown.replace("{seconds}", "5")}
          </p>
        </div>
        <div class="thanks-video-wrap">
          <video src="/files/agradecimento.mp4" autoplay muted playsinline preload="auto"></video>
        </div>
      </div>
    </div>
  </main>

  <script
    define:vars={{
      countdownTpl: t.countdown,
      docsHref,
      linuxUrl: LINUX_URL,
      macUrl: MAC_URL,
    }}
  >
    (function () {
      const ua = (navigator.userAgent || "") + (navigator.platform || "");
      const isWindows = /windows|win32|win64/i.test(ua);
      const isMac = !isWindows && /mac|darwin/i.test(ua);

      let downloadUrl;
      let downloadName;
      if (isWindows) {
        downloadUrl = "/ottavada.cmd";
        downloadName = "ottavada.cmd";
      } else if (isMac) {
        downloadUrl = macUrl;
      } else {
        downloadUrl = linuxUrl;
        downloadName = "ottavada.sh";
      }

      const downloadLink = document.createElement("a");
      downloadLink.href = downloadUrl;
      if (downloadName) downloadLink.download = downloadName;
      downloadLink.style.display = "none";
      document.body.appendChild(downloadLink);
      downloadLink.click();
      document.body.removeChild(downloadLink);

      let seconds = 5;
      const countdownEl = document.getElementById("thanks-countdown");
      const timerId = setInterval(() => {
        seconds -= 1;
        if (seconds <= 0) {
          clearInterval(timerId);
          window.location.href = docsHref;
          return;
        }
        if (countdownEl) {
          countdownEl.textContent = countdownTpl.replace("{seconds}", String(seconds));
        }
      }, 1000);
    })();
  </script>
</ThanksLayout>
