---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { withLocale, type Locale } from "~/i18n";
import "~/styles/notfound.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const homeHref = withLocale("/", locale);
---

<BaseLayout
  locale={locale}
  title="Score Maestro — Página não encontrada"
  description="Página não encontrada."
  bodyClass="notfound-body"
>
  <main class="notfound-layout">
    <img
      src="/notfound.avif"
      alt="Ilustração de página não encontrada"
      class="bg-img"
    />
    <section class="notfound-card">
      <div class="notfound-badge">Erro 404</div>
      <h1>Página não encontrada</h1>
      <div class="btn-wrap">
        <a href={homeHref} class="button">Voltar para a página inicial</a>
      </div>
    </section>
  </main>
</BaseLayout>
