---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { ui, withLocale, type Locale } from "~/i18n";
import "~/styles/notfound.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const { notFound } = ui[locale];
const homeHref = withLocale("/", locale);
---

<BaseLayout
  locale={locale}
  title={notFound.title}
  description={notFound.description}
  bodyClass="notfound-body"
>
  <main class="notfound-layout">
    <img
      src="/notfound.avif"
      alt={notFound.imgAlt}
      class="bg-img"
    />
    <section class="notfound-card">
      <div class="notfound-badge">{notFound.badge}</div>
      <h1>{notFound.heading}</h1>
      <div class="btn-wrap">
        <a href={homeHref} class="button">{notFound.backHome}</a>
      </div>
    </section>
  </main>
</BaseLayout>
