---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { download, type Locale } from "~/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = download[locale];

const ogUrl = `https://ottavada.com/${locale}/download/`;

const RELEASE_BASE = import.meta.env.PUBLIC_RELEASE_BASE;
const LINUX_URL = `${RELEASE_BASE}/${import.meta.env.PUBLIC_LINUX_APPIMAGE}`;
const MAC_URL = `${RELEASE_BASE}/${import.meta.env.PUBLIC_MAC_DMG}`;
const WIN_X32_URL = `${RELEASE_BASE}/${import.meta.env.PUBLIC_WIN_X32}`;
const WIN_X64_URL = `${RELEASE_BASE}/${import.meta.env.PUBLIC_WIN_X64}`;
---

<BaseLayout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  ogTitle={t.meta.ogTitle}
  ogDescription={t.meta.ogDescription}
  ogUrl={ogUrl}
>
  <main class="dl-page">
    <div class="container dl-container">
      <h1 class="dl-heading">{t.heading}</h1>

      <div class="dl-cards">
        <div class="dl-card">
          <div class="dl-card-head">
            <span class="dl-card-os">{t.windows}</span>
            <span class="dl-card-arch">{t.archLabel.win}</span>
          </div>
          <div class="dl-card-actions">
            <a class="button button-sm" href="/ottavada.cmd" download="ottavada.cmd">{t.winInstaller}</a>
          </div>
          <div class="dl-card-actions">
            <a class="button button-sm" href={WIN_X64_URL}>{t.winX64}</a>
            <a class="button button-sm" href={WIN_X32_URL}>{t.winX32}</a>
          </div>
        </div>
        <a class="dl-card" href={LINUX_URL}>
          <div class="dl-card-head">
            <span class="dl-card-os">{t.linux}</span>
            <span class="dl-card-arch">{t.archLabel.linux}</span>
          </div>
          <div class="dl-card-actions">
            <span class="button button-sm">{t.linuxBtn}</span>
          </div>
        </a>
        <a class="dl-card" href={MAC_URL}>
          <div class="dl-card-head">
            <span class="dl-card-os">{t.mac}</span>
            <span class="dl-card-arch">{t.archLabel.mac}</span>
          </div>
          <div class="dl-card-actions">
            <span class="button button-sm">{t.macBtn}</span>
          </div>
        </a>
      </div>
    </div>
  </main>

  <style>
    .dl-page {
      padding: 7rem 0 3rem;
      min-height: 100vh;
    }
    .dl-container {
      max-width: 42rem;
    }
    .dl-heading {
      font-size: 2.2rem;
      font-weight: 800;
      text-align: center;
      margin-bottom: 2rem;
    }
    .dl-cards {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .dl-card {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem 1.5rem;
      border-radius: 0.85rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.03);
      text-decoration: none;
      transition:
        background 200ms,
        border-color 200ms;
    }
    .dl-card:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.2);
    }
    .dl-card-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .dl-card-os {
      font-weight: 700;
      font-size: 1.15rem;
    }
    .dl-card-arch {
      color: var(--muted);
      font-size: 0.85rem;
    }
    .dl-card-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.9rem;
    }
    .button-sm {
      padding: 0.6rem 1.3rem;
      font-size: 0.85rem;
      white-space: nowrap;
    }
    @media (max-width: 640px) {
      .dl-heading {
        font-size: 1.6rem;
      }
      .dl-card {
        padding: 1.25rem 1rem;
      }
      .dl-card-actions {
        flex-direction: column;
        width: 100%;
      }
      .button-sm {
        width: 100%;
      }
    }
  </style>
</BaseLayout>
