---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { download, type Locale } from "~/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = download[locale];

const ogUrl = `https://ottavada.com/${locale}/download/`;

const RELEASE_BASE = "https://github.com/Faell4328/ottavada/releases/download/v1.3";
---

<BaseLayout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  ogTitle={t.meta.ogTitle}
  ogDescription={t.meta.ogDescription}
  ogUrl={ogUrl}
>
  <main class="dl-page">
    <div class="container dl-container">
      <h1 class="dl-heading">{t.heading}</h1>

      <div class="dl-cards">
        <a class="dl-card" href="/ottavada.cmd" download="ottavada.cmd">
          <span class="dl-card-os">{t.windows}</span>
          <span class="dl-card-arch">{t.archLabel.win}</span>
          <span class="button button-sm">{t.downloadBtn}</span>
        </a>
        <a class="dl-card" href={RELEASE_BASE + "/Linux_Ottavada_x64.AppImage"}>
          <span class="dl-card-os">{t.linux}</span>
          <span class="dl-card-arch">{t.archLabel.linux}</span>
          <span class="button button-sm">{t.downloadBtn}</span>
        </a>
        <a class="dl-card" href="/ottavada.sh" download="ottavada.sh">
          <span class="dl-card-os">{t.mac}</span>
          <span class="dl-card-arch">{t.archLabel.mac}</span>
          <span class="button button-sm">{t.downloadBtn}</span>
        </a>
      </div>
    </div>
  </main>

  <style>
    .dl-page {
      padding: 7rem 0 3rem;
      min-height: 100vh;
    }
    .dl-container {
      max-width: 42rem;
    }
    .dl-heading {
      font-size: 2.2rem;
      font-weight: 800;
      text-align: center;
      margin-bottom: 2rem;
    }
    .dl-cards {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .dl-card {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding: 1.25rem 1.5rem;
      border-radius: 0.85rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.03);
      text-decoration: none;
      transition:
        background 200ms,
        border-color 200ms;
    }
    .dl-card:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.2);
    }
    .dl-card-os {
      font-weight: 700;
      font-size: 1.1rem;
      min-width: 6rem;
    }
    .dl-card-arch {
      color: var(--muted);
      font-size: 0.85rem;
      flex: 1;
    }
    .button-sm {
      padding: 0.4rem 1.2rem;
      font-size: 0.85rem;
    }
    @media (max-width: 640px) {
      .dl-heading {
        font-size: 1.6rem;
      }
      .dl-card {
        flex-wrap: wrap;
        gap: 0.75rem;
      }
    }
  </style>
</BaseLayout>
